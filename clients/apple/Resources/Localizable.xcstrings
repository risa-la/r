      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Risala"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسالة"
          }
        }
      }
    },
    "Choose a room": {
      "comment": "Title when no room is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a room"
          }
        },
