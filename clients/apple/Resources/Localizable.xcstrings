        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الهدهد يحمل رسالة وليس لديه مكان يأخذها إليه."
          }
        }
      }
    },
    "Give Hudhud a job": {
      "comment": "Empty chat list primary action; opens the command line. Hudhud is the app's hoopoe mascot.",
      "extractionState": "manual",
      "localizations": {
