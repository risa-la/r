    "Hudhud is holding a letter with nowhere to take it.": {
      "comment": "Empty chat list message. Hudhud is the app's hoopoe mascot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hudhud is holding a letter with nowhere to take it."
