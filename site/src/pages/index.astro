---
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import AppMock from "../components/AppMock.astro";
import Glyph from "../components/Glyph.astro";
import { REPO_URL } from "../docs";
import { readSummary } from "../verification/build";
import shieldStar from "@phosphor-icons/core/assets/bold/shield-star-bold.svg?raw";
import swap from "@phosphor-icons/core/assets/bold/swap-bold.svg?raw";
import clockCountdown from "@phosphor-icons/core/assets/bold/clock-countdown-bold.svg?raw";
import personSimpleRun from "@phosphor-icons/core/assets/bold/person-simple-run-bold.svg?raw";
import cubeTransparent from "@phosphor-icons/core/assets/bold/cube-transparent-bold.svg?raw";
import hardDrives from "@phosphor-icons/core/assets/bold/hard-drives-bold.svg?raw";
import appleLogo from "@phosphor-icons/core/assets/bold/apple-logo-bold.svg?raw";
import googlePlayLogo from "@phosphor-icons/core/assets/bold/google-play-logo-bold.svg?raw";
import linuxLogo from "@phosphor-icons/core/assets/bold/linux-logo-bold.svg?raw";

const features: { icon: string; tint: "ink" | "mode" | "location" | "mention" | "presence"; title: string; text: string }[] = [
  { icon: shieldStar, tint: "ink", title: "Everything encrypted", text: "Direct conversations, private rooms and public rooms all use MLS, with a new key for every message. Messages are deniable: one that leaks does not prove who wrote it." },
  { icon: swap, tint: "mode", title: "Zero trust in the server", text: "Devices check membership, roles and keys themselves. The server carries messages without learning who sent them, or who is in a private conversation." },
  { icon: clockCountdown, tint: "ink", title: "No history on the server", text: "Encrypted messages wait only until devices fetch them. History moves between your own devices, with an optional backup only your recovery key opens." },
  { icon: personSimpleRun, tint: "mention", title: "Portable identity", text: "alice@example.org is whoever controls a key file on example.org, and every key is in a log that public witnesses check." },
  { icon: cubeTransparent, tint: "presence", title: "Post-quantum", text: "ML-KEM hybrid key exchange in TLS, X-Wing in MLS, and ML-DSA signatures for identities and devices." },
  { icon: hardDrives, tint: "location", title: "Independent servers", text: "No federation, and no server is special. Private rooms of up to 1,000 members, public rooms of up to 10,000." },
];

// Not released yet: these render as placeholders, not links.
const stores = [
  { logo: appleLogo, store: "App Store", platforms: "iPhone, iPad and Mac" },
  { logo: googlePlayLogo, store: "Google Play", platforms: "Android" },
  { logo: linuxLogo, store: "Linux", platforms: "desktop" },
];

// The verification numbers, read when the site is built. Without results
// the panel says so rather than showing zeros.
const summary = readSummary();
const share = (t?: { covered: number; total: number }) =>
  t && t.total ? `${(Math.floor((1000 * t.covered) / t.total) / 10).toFixed(1)}%` : undefined;
const tests = summary ? [summary.tests.unit, summary.tests.integration, summary.tests.swift].filter((t) => t !== null) : [];
const fuzzSeconds = summary?.fuzz.reduce((a, t) => a + (t.seconds ?? 0), 0) ?? 0;
const tlaDone = summary?.tla.runs.filter((r) => r.result !== "none") ?? [];
const stats: { value?: string; label: string; detail?: string }[] = [
  {
    value: summary?.has.unit || summary?.has.integration ? share(summary.totals.any) : undefined,
    label: "lines reached",
    detail: summary?.totals.any.total ? `by tests, fuzzing or proofs, of ${summary.totals.any.total.toLocaleString("en")}` : undefined,
  },
  {
    value: tests.length ? `${tests.reduce((a, t) => a + (t.passed ?? 0), 0).toLocaleString("en")}` : undefined,
    label: "tests passed",
    detail: tests.length ? `${tests.reduce((a, t) => a + (t.failed ?? 0), 0)} failed` : undefined,
  },
  {
    value: summary?.has.kani ? `${summary.kani.filter((p) => p.status === "success").length}/${summary.kani.length}` : undefined,
    label: "kani proofs pass",
  },
  {
    value: summary?.has.fuzz ? `${(fuzzSeconds / 3600).toFixed(fuzzSeconds < 36000 ? 1 : 0)}h` : undefined,
    label: "fuzzed",
    detail: summary?.has.fuzz ? `over ${summary.fuzz.length} targets` : undefined,
  },
  {
    value: summary?.has.tla ? tlaDone.reduce((a, r) => a + (r.distinct ?? 0), 0).toLocaleString("en") : undefined,
    label: "tla+ states checked",
    detail: summary?.has.tla ? `${tlaDone.filter((r) => r.asExpected).length} of ${tlaDone.length} runs as expected` : undefined,
  },
];
---

<Base description="risala is a modern chat protocol for independent servers, in which every conversation is end-to-end encrypted and the server keeps no history.">
  <div class="home">
    <section class="panel intro">
      <img class="hudhud" src="/hudhud.png" alt="" width="901" height="1019" />
      <div>
        <h1>a modern chat protocol for independent servers</h1>
        <p>
          Rooms, direct conversations, guests, replies and reactions, with every conversation
          end-to-end encrypted, public rooms included. The server keeps no history and does not
          learn who sends what.
        </p>
        <div class="actions">
          <a class="button primary" href="/spec/">▲ read the spec</a>
          <a class="button" href={REPO_URL}>view source</a>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head"><Breadcrumb parts={[{ label: "features" }]} /></div>
      <ul class="features">
        {
          features.map((f) => (
            <li>
              <Glyph icon={f.icon} tint={f.tint} />
              <div>
                <strong>{f.title}</strong>
                <span>{f.text}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel verify">
      <div class="panel-head"><Breadcrumb parts={[{ label: "verification", href: "/verification/" }]} /></div>
      <div class="panel-body">
        <dl class="stats">
          {
            stats.map((s) => (
              <div>
                <dt class="label">{s.label}</dt>
                <dd class:list={["value", { none: !s.value }]}>{s.value ?? "-"}</dd>
                <dd class="label">{s.value ? s.detail : "no results yet"}</dd>
              </div>
            ))
          }
        </dl>
        <p class="verify-foot">
          {summary?.commit ? <span>for commit {summary.commit.slice(0, 10)}. </span> : <span>no results for this commit yet. </span>}
          <a href="/verification/">see how the code is checked, line by line</a>
        </p>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head"><Breadcrumb parts={[{ label: "apps" }]} /></div>
      <div class="panel-body apps">
        <div class="apps-lead">
          <strong>coming soon</strong>
          <span>Apps for Apple devices, Android and Linux are on the way.</span>
        </div>
        <AppMock />
        <ul class="stores">
          {
            stores.map((s) => (
              <li class="store" aria-label={`${s.store}, ${s.platforms}: coming soon`}>
                <span class="store-logo" aria-hidden="true" set:html={s.logo} />
                <span class="store-name" aria-hidden="true">
                  <small>{s.platforms}</small>
                  <strong>{s.store}</strong>
                </span>
                <span class="soon" aria-hidden="true">soon</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .home {
    display: grid;
    gap: var(--panel-inset);
    margin: 0 auto;
  }
  .intro {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 36px;
    padding: 36px;
  }
  .hudhud {
    width: auto;
    height: 150px;
    image-rendering: pixelated;
  }
  h1 {
    margin: 0 0 8px;
    font-size: 20px;
    line-height: 1.35;
    font-weight: 800;
    text-transform: lowercase;
  }
  p {
    margin: 0;
    max-width: 60ch;
    color: var(--text-tertiary);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--inline);
    margin-top: 24px;
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0 var(--inline);
  }
  .features li {
    display: flex;
    align-items: baseline;
    gap: var(--row-padding);
    padding: var(--row-padding);
  }
  .features :global(.glyph) {
    position: relative;
    top: 4px;
  }
  .features div {
    display: grid;
  }
  .features strong {
    font-weight: 700;
    font-size: 13px;
  }
  .features span {
    font-size: 12px;
    color: var(--text-tertiary);
  }
  .apps {
    display: grid;
    gap: 16px;
  }
  .apps-lead {
    display: grid;
  }
  .apps-lead strong {
    font-size: 15px;
    font-weight: 800;
  }
  .apps-lead span {
    font-size: 12px;
    color: var(--text-tertiary);
  }
  ul.stores {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--inline);
    padding: 0;
  }
  .store {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 8px 14px;
    border: 1px dashed var(--rule);
    border-radius: var(--row-radius);
    background: color-mix(in srgb, var(--text) 4%, transparent);
  }
  .store-logo {
    display: grid;
    color: var(--text-secondary);
  }
  .store-logo :global(svg) {
    width: 24px;
    height: 24px;
  }
  .store-name {
    display: grid;
    flex: 1;
    line-height: 1.3;
  }
  .store-name small {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .store-name strong {
    font-size: 14px;
    font-weight: 700;
  }
  .soon {
    flex: none;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    color: var(--mention);
    background: color-mix(in srgb, var(--mention) 16%, transparent);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: var(--inline);
  }
  @media (max-width: 640px) {
    .intro {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: 28px var(--panel-padding);
    }
    .hudhud {
      height: 110px;
    }
    .actions {
      justify-content: center;
    }
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--inline);
    margin: 0;
  }
  .stats div {
    padding: var(--row-padding);
    border: 1px solid var(--rule);
    border-radius: var(--row-radius);
  }
  .stats dd {
    margin: 0;
  }
  .stats .value {
    font-size: 20px;
    font-weight: 800;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .stats .value.none {
    color: var(--text-tertiary);
  }
  .verify-foot {
    margin-top: 12px;
    max-width: none;
    font-size: 12px;
  }
</style>
