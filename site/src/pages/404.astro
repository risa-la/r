---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <section class="panel">
    <img src="/hudhud.png" alt="" width="901" height="1019" />
    <h1>nothing here</h1>
    <p>hudhud looked everywhere and came back with the letter.</p>
    <a class="button primary" href="/">go home</a>
  </section>
</Base>

<style>
  section {
    margin: 0 auto;
    min-height: 60vh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding: 48px var(--panel-padding);
  }
  img {
    height: 170px;
    width: auto;
    image-rendering: pixelated;
    margin-bottom: 28px;
  }
  h1 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
  }
  p {
    margin: 4px 0 24px;
    color: var(--text-tertiary);
  }
</style>
