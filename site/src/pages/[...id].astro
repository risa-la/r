---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { REPO_URL, docTitle, docVersion } from "../docs";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((doc) => ({ params: { id: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
const title = docTitle(doc.id, doc.body);
const version = docVersion(doc.body);
const source = doc.filePath?.replace(/^\.\.\//, "");
// The sidebar replaces the document's own contents list on wide screens.
const contents = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== "contents");
---

<Base title={title}>
  <div class="layout">
    <article class="panel doc">
      <header>
        <Breadcrumb parts={doc.id.split("/").map((label) => ({ label }))} />
        <h1>{title}</h1>
        <dl>
          {
            version && (
              <div>
                <dt class="label">version</dt>
                <dd>{version}</dd>
              </div>
            )
          }
          {
            source && (
              <div>
                <dt class="label">source</dt>
                <dd>
                  <a href={`${REPO_URL}/blob/main/${source}`}>{source}</a>
                </dd>
              </div>
            )
          }
        </dl>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>

    {
      contents.length > 0 && (
        <aside class="panel toc">
          <div class="panel-head">
            <span class="label">contents</span>
          </div>
          <nav aria-label="Contents">
            <ul>
              {contents.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // A link on each heading, and the current section marked in the contents.
  const headings = [...document.querySelectorAll<HTMLElement>(".prose :is(h2, h3, h4)[id]")];

  // The document's own contents list (shown when there is no sidebar) names
  // its sections as plain text; link each entry to its heading.
  const sections = headings.filter((h) => h.tagName === "H2");
  for (const li of document.querySelectorAll(".prose :is(#contents + ol, #contents + ol + ul) > li")) {
    const name = li.textContent!.trim();
    // "Introduction" names "1. Introduction"; "Appendix C. Push Gateways"
    // names "Appendix C. Push Gateways (Informative)".
    const target = sections.find((h) => {
      const text = h.textContent!.trim();
      return text.endsWith(name) || text.startsWith(name);
    });
    if (!target || li.querySelector("a")) continue;
    const a = document.createElement("a");
    a.href = `#${target.id}`;
    a.textContent = name;
    li.replaceChildren(a);
  }
  for (const h of headings) {
    const a = document.createElement("a");
    a.className = "anchor";
    a.href = `#${h.id}`;
    a.setAttribute("aria-label", "Link to this section");
    a.textContent = "#";
    h.append(a);
  }

  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>(".toc a")].map((a) => [
      decodeURIComponent(a.hash.slice(1)),
      a,
    ]),
  );
  const tracked = headings.filter((h) => links.has(h.id));
  let current: HTMLAnchorElement | undefined;

  function mark() {
    // A heading counts as current once it is near the top of the window.
    const line = innerHeight / 4;
    let id = tracked[0]?.id;
    for (const h of tracked) {
      if (h.getBoundingClientRect().top > line) break;
      id = h.id;
    }
    const link = id ? links.get(id) : undefined;
    if (link === current) return;
    current?.removeAttribute("aria-current");
    link?.setAttribute("aria-current", "location");
    current = link;
    link?.scrollIntoView({ block: "nearest" });
  }

  let queued = false;
  addEventListener(
    "scroll",
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        mark();
      });
    },
    { passive: true },
  );
  mark();
</script>

<style>
  /* The document panel is as wide as its text, beside the contents, and the
     two sit in the middle of the window. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, calc(var(--measure) + 2 * var(--panel-padding))) var(--sidebar);
    justify-content: center;
    gap: var(--panel-inset);
    align-items: start;
  }
  .doc {
    padding-bottom: 48px;
  }
  header {
    padding: var(--panel-padding) var(--panel-padding) 0;
  }
  h1 {
    margin: 36px 0 20px;
    font-size: 28px;
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  dl {
    display: flex;
    flex-wrap: wrap;
    margin: 0 calc(-1 * var(--panel-padding));
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  dl div {
    padding: 10px var(--panel-padding);
    border-right: 1px solid var(--rule);
  }
  dt {
    margin-bottom: 2px;
  }
  dd {
    margin: 0;
    font-size: 13px;
  }
  .toc {
    position: sticky;
    top: calc(var(--topbar));
    max-height: calc(100vh - var(--topbar) - var(--panel-inset));
    display: flex;
    flex-direction: column;
  }
  .toc nav {
    overflow-y: auto;
    padding: 0 var(--inline) var(--inline);
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc a {
    display: block;
    padding: 3px var(--inline);
    border-radius: 6px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .toc .depth-3 a {
    padding-left: calc(var(--inline) + 2ch);
    color: var(--text-tertiary);
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a[aria-current] {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, calc(var(--measure) + 2 * var(--panel-padding)));
    }
    .toc {
      display: none;
    }
  }
  /* With the sidebar showing, hide the document's own contents list. */
  @media (min-width: 961px) {
    .prose :global(:is(#contents, #contents + :is(ol, ul), #contents + ol + ul)) {
      display: none;
    }
  }

  .prose {
    padding: 8px var(--panel-padding) 0;
    color: var(--text);
  }
  /* The page header already shows the title and version, so hide the
     document's own: its first heading, and the spec's boxed header below it. */
  .prose :global(> h1:first-child),
  .prose :global(> h1:first-child + pre) {
    display: none;
  }
  .prose :global(> h1:first-child + pre + h2),
  .prose :global(> h1:first-child + h2) {
    margin-top: 24px;
    padding-top: 0;
    border-top: 0;
  }
  /* Section headings draw their own rule; the spec's "---" lines before
     them would double it. */
  .prose :global(hr) {
    display: none;
  }
  .prose :global(h2) {
    margin: 48px 0 16px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    font-size: 18px;
    font-weight: 800;
    line-height: 1.35;
  }
  .prose :global(h3) {
    margin: 32px 0 12px;
    font-size: 15px;
    font-weight: 700;
  }
  .prose :global(h4) {
    margin: 24px 0 8px;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-secondary);
  }
  .prose :global(.anchor) {
    margin-left: 1ch;
    color: var(--rule);
    text-decoration: none;
    opacity: 0;
  }
  .prose :global(:is(h2, h3, h4):hover .anchor),
  .prose :global(.anchor:focus-visible) {
    opacity: 1;
  }
  .prose :global(.anchor:hover) {
    color: var(--mode);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre),
  .prose :global(table) {
    margin: 0 0 16px;
  }
  .prose :global(:is(ul, ol)) {
    padding-left: 3ch;
  }
  .prose :global(li + li),
  .prose :global(li > :is(ul, ol)) {
    margin-top: 4px;
  }
  .prose :global(ul > li::marker) {
    content: "- ";
    color: var(--text-tertiary);
  }
  .prose :global(ol > li::marker) {
    color: var(--text-tertiary);
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(:not(pre) > code) {
    padding: 1px 4px;
    border-radius: 4px;
    font-size: 0.93em;
    color: var(--mode);
    background: color-mix(in srgb, var(--mode) 10%, transparent);
  }
  .prose :global(pre) {
    padding: 12px var(--panel-padding);
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--row-radius);
    background: var(--surface);
    font-size: 13px;
    line-height: 1.6;
  }
  .prose :global(blockquote) {
    padding: 0 0 0 2ch;
    border-left: 2px solid var(--mode);
    color: var(--text-secondary);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    overflow-wrap: break-word;
  }
  .prose :global(:is(th, td)) {
    padding: 6px 12px;
    border: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    overflow-wrap: normal;
    font-weight: 700;
    background: var(--surface);
  }

  /* Phones: nothing scrolls sideways. Code wraps, and long words, links
     and tables break to fit. */
  @media (max-width: 640px) {
    .prose {
      overflow-wrap: anywhere;
    }
    .prose :global(pre) {
      padding: 10px 12px;
      font-size: 12px;
      white-space: pre-wrap;
    }
    .prose :global(table) {
      font-size: 12px;
      overflow-wrap: anywhere;
    }
    .prose :global(:is(th, td)) {
      padding: 4px 6px;
    }
  }
</style>
