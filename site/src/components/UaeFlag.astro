---
// A pixel-art UAE flag for the footer: one unit is one pixel, drawn at 2x.
// A light pixel top left and darker bottom and right edges give it some
// depth. Decorative; the text beside it names the country.
---

<svg class="flag" viewBox="0 0 12 6" width="24" height="12" aria-hidden="true">
  <rect x="0" y="0" width="1" height="1" fill="#ff6b76" />
  <rect x="1" y="0" width="2" height="1" fill="#ef3340" />
  <rect x="3" y="0" width="1" height="1" fill="#2fa862" />
  <rect x="4" y="0" width="8" height="1" fill="#00843d" />
  <rect x="0" y="1" width="3" height="1" fill="#ef3340" />
  <rect x="3" y="1" width="8" height="1" fill="#00843d" />
  <rect x="11" y="1" width="1" height="1" fill="#006230" />
  <rect x="0" y="2" width="3" height="1" fill="#ef3340" />
  <rect x="3" y="2" width="8" height="1" fill="#ffffff" />
  <rect x="11" y="2" width="1" height="1" fill="#d9dbe0" />
  <rect x="0" y="3" width="3" height="1" fill="#ef3340" />
  <rect x="3" y="3" width="8" height="1" fill="#ffffff" />
  <rect x="11" y="3" width="1" height="1" fill="#d9dbe0" />
  <rect x="0" y="4" width="3" height="1" fill="#ef3340" />
  <rect x="3" y="4" width="8" height="1" fill="#1a1a1a" />
  <rect x="11" y="4" width="1" height="1" fill="#000000" />
  <rect x="0" y="5" width="3" height="1" fill="#c4222f" />
  <rect x="3" y="5" width="9" height="1" fill="#000000" />
</svg>

<style>
  .flag {
    flex: none;
    shape-rendering: crispEdges;
  }
</style>
